{
  "name": "@socioprophet/gbrg-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-trust MCP server exposing GBRG blast-radius tools (impact_query, minimal_context_query, graph_status). Every tool returns a ProofArtifact object; every call is authorized fail-closed and ledgered.",
  "type": "module",
  "license": "MIT",
  "main": "dist/src/server.js",
  "bin": {
    "gbrg-mcp": "dist/src/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "gen-registry": "python3 mcp_gate.py gen-registry --out registry/capability_registry.json",
    "test": "npm run build && node dist/test/zero_trust_test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  }
}
