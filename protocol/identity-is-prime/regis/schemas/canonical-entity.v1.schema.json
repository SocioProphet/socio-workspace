{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/identity-is-prime/regis/canonical-entity.v1.schema.json",
  "title": "Regis Canonical Entity v1",
  "description": "A materialized canonical entity in the Regis Entity Graph. Derived from Event-IR plus review signals; never free-written as canonical truth except through a DecisionLedgerEntry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entity_id",
    "entity_type",
    "identity_state",
    "scope_flags",
    "member_record_refs",
    "lifecycle",
    "provenance",
    "resolver_version",
    "policy_version",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "regis.canonical-entity.v1" },
    "entity_id": { "type": "string", "pattern": "^ce_[a-zA-Z0-9_.:-]+$" },
    "entity_type": {
      "type": "string",
      "enum": [
        "PERSON",
        "ORG",
        "PRODUCT_OR_SERVICE",
        "DEVICE",
        "ACCOUNT",
        "IDENTIFIER",
        "CREDENTIAL",
        "LOCATION",
        "JURISDICTION",
        "CONSENT_ARTIFACT",
        "POLICY_TERM",
        "ACTION_OR_EVENT",
        "OTHER"
      ]
    },
    "identity_state": {
      "type": "string",
      "description": "Lifecycle of the resolution itself, not the record content.",
      "enum": ["candidate", "context_resolved", "resolved", "contested", "merged", "split", "revoked", "expired"]
    },
    "identity_mixture": {
      "type": "object",
      "description": "Active prime-topic mixture for this entity (prime-topic -> multiplicity), per Identity Is Prime decomposition.",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "scope_flags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Sovereignty realms this entity has been observed in (fog-first scope model).",
      "items": {
        "type": "string",
        "pattern": "^(CITIZEN_FOG|CITIZEN_CLOUD|INSTITUTION|ADTECH|HSM|DEVICE|APP|CLOUD)([A-Z0-9_]*[A-Z0-9])?$"
      }
    },
    "member_record_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "SourceRecord ids clustered into this canonical entity.",
      "items": { "type": "string", "pattern": "^sr_[a-zA-Z0-9_.:-]+$" }
    },
    "concordance_link_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "decision_ledger_refs": {
      "type": "array",
      "uniqueItems": true,
      "description": "Append-only DecisionLedgerEntry ids that produced or amended this entity. The entity is rebuildable by replaying these in order.",
      "items": { "type": "string", "pattern": "^dl_[a-zA-Z0-9_.:-]+$" }
    },
    "proof_certificate_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "contradiction_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^co_[a-zA-Z0-9_.:-]+$" }
    },
    "release_pack_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "type": "string", "enum": ["active", "pending", "merged", "split", "revoked", "expired", "superseded", "redacted", "synthetic"] },
        "valid_from": { "type": ["string", "null"], "format": "date-time" },
        "valid_until": { "type": ["string", "null"], "format": "date-time" },
        "superseded_by": { "type": ["string", "null"], "pattern": "^ce_[a-zA-Z0-9_.:-]+$" }
      }
    },
    "policy_tags": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_ref", "observed_at"],
        "properties": {
          "source_ref": { "type": "string" },
          "observed_at": { "type": "string", "format": "date-time" },
          "claim_ref": { "type": ["string", "null"] },
          "evidence_hash": { "type": ["string", "null"] },
          "ledger_pointer": { "type": ["string", "null"] }
        }
      }
    },
    "resolver_version": { "type": "string" },
    "policy_version": { "type": "string" },
    "schema_pins": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "template_version": { "type": ["string", "null"] },
        "fixture_version": { "type": ["string", "null"] }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "notes": { "type": ["string", "null"] }
  }
}
