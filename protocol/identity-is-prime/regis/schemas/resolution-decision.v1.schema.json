{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/identity-is-prime/regis/resolution-decision.v1.schema.json",
  "title": "Regis Resolution Decision v1",
  "description": "The required externalized output of every material resolution operation. Carries the machine-readable decision, explanation, policy verdict, witness chain, confidence + uncertainty, reversibility/action class, and a proof-artifact reference. ER is explainable and policy-constrained, never merely probabilistic.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "operation",
    "decision",
    "subjects",
    "explanation",
    "policy_verdict",
    "witness_chain",
    "confidence",
    "reversibility",
    "decided_by",
    "resolver_version",
    "policy_version",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "regis.resolution-decision.v1" },
    "decision_id": { "type": "string", "pattern": "^rd_[a-zA-Z0-9_.:-]+$" },
    "operation": {
      "type": "string",
      "enum": ["resolve", "merge", "unmerge", "split", "link", "unlink", "no_op"]
    },
    "decision": {
      "type": "string",
      "description": "Discrete resolution outcome (never a bare score).",
      "enum": ["merge", "possible_match", "blocked", "unrelated", "unmerged"]
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Records/entities the decision ranges over (sr_/ce_ ids).",
      "items": { "type": "string", "pattern": "^(sr_|ce_)[a-zA-Z0-9_.:-]+$" }
    },
    "result_entity_ref": { "type": ["string", "null"], "pattern": "^ce_[a-zA-Z0-9_.:-]+$" },
    "scope_realm": {
      "type": "string",
      "pattern": "^(CITIZEN_FOG|CITIZEN_CLOUD|INSTITUTION|ADTECH|HSM|DEVICE|APP|CLOUD)([A-Z0-9_]*[A-Z0-9])?$"
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top_features", "summary"],
      "description": "Human- and machine-readable rationale; top contributing features mirror the EdgeWitness evidence.",
      "properties": {
        "top_features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["feature", "contribution"],
            "properties": {
              "feature": { "type": "string" },
              "contribution": { "type": "number" }
            }
          }
        },
        "summary": { "type": "string" }
      }
    },
    "policy_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict"],
      "properties": {
        "verdict": { "type": "string", "enum": ["allowed", "vetoed", "review_required"] },
        "reason_codes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "forbidden_mixture": { "type": ["array", "null"], "items": { "type": "string" } },
        "policy_decision_ref": { "type": ["string", "null"] }
      }
    },
    "witness_chain": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "EdgeWitness ids that justify this decision.",
      "items": { "type": "string", "pattern": "^ew_[a-zA-Z0-9_.:-]+$" }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "uncertainty"],
      "description": "Calibrated score with a mandatory uncertainty summary so abstention is auditable.",
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "uncertainty": { "type": "number", "minimum": 0, "maximum": 1 },
        "band": { "type": "string", "enum": ["low", "medium", "high"] },
        "abstained": { "type": "boolean", "default": false }
      }
    },
    "reversibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reversible", "action_class"],
      "description": "Merge and unmerge are first-class; every decision declares whether it can be undone and how risky it is.",
      "properties": {
        "reversible": { "type": "boolean" },
        "action_class": { "type": "string", "enum": ["read_only", "reversible_write", "guarded_write", "irreversible"] },
        "undo_ref": { "type": ["string", "null"], "pattern": "^dl_[a-zA-Z0-9_.:-]+$", "description": "DecisionLedgerEntry that would reverse this operation." }
      }
    },
    "proof_artifact_ref": {
      "type": ["string", "null"],
      "description": "Reference to a ProofArtifact / certificate substantiating the decision (regis proof certificate or identity-is-prime proof_artifact)."
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "description": "Human review binding when the decision is review_required.",
      "properties": {
        "required": { "type": "boolean" },
        "state": { "type": "string", "enum": ["not_required", "required", "in_review", "approved", "rejected", "escalated"] },
        "reviewer_ref": { "type": ["string", "null"] }
      }
    },
    "decided_by": {
      "type": "string",
      "description": "Agent identity from the Agent Registry (e.g. regis-policy-agent). Agents do not free-write canonical truth."
    },
    "resolver_version": { "type": "string" },
    "policy_version": { "type": "string" },
    "schema_pins": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "fixture_version": { "type": ["string", "null"] },
        "input_hash": { "type": ["string", "null"] },
        "result_hash": { "type": ["string", "null"] }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
