{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/active-spine.repo-graph.findings.schema.json",
  "title": "Active Spine Repo Graph Findings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "corpus_loop",
    "generated_from",
    "finding_kinds",
    "findings"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "kind": { "const": "active_spine_repo_graph_findings" },
    "corpus_loop": { "const": "watson-cyc-semantic-web-chronos-v1" },
    "generated_from": { "const": "registry/neurosymbolic-repo-graph-reasoner/graph-lift.manifest.json" },
    "finding_kinds": {
      "type": "array",
      "minItems": 5,
      "items": {
        "enum": [
          "blocked-non-actionable",
          "missing-surface",
          "policy-review-required",
          "promotion-ready",
          "stale-pin"
        ]
      },
      "contains": { "const": "promotion-ready" }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "severity", "reason", "actionable"],
      "properties": {
        "kind": {
          "enum": [
            "blocked-non-actionable",
            "missing-surface",
            "policy-review-required",
            "promotion-ready",
            "stale-pin"
          ]
        },
        "repository": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warn", "review"] },
        "reason": { "type": "string", "minLength": 1 },
        "actionable": { "type": "boolean" }
      }
    }
  }
}
