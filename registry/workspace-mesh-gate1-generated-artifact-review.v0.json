    },
    {
      "name": "clasp.generated.json",
      "kind": "apps_script_clasp_config",
      "required_checks": [
        "scriptId_placeholder_or_gate2_started",
        "rootDir_expected",
        "filePushOrder_expected",
        "no_secrets",
        "not_a_clasp_push"
      ]
    },
    {
      "name": "mesh-summary.generated.json",
      "kind": "mesh_summary",
      "required_checks": [
        "dry_run_true",
        "project_services_enabled_false",
