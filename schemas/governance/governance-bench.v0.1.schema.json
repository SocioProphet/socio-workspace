{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/sociosphere/governance/governance-bench.v0.1.schema.json",
  "title": "GovernanceBench v0.1",
  "description": "Benchmark contract for authority-boundary, policy, approval, override, audit, and fail-closed governance behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "benchId", "title", "ownerRepo", "rubric", "testCases", "thresholds", "provenance"],
  "properties": {
    "schemaVersion": { "const": "governance.governance-bench.v0.1" },
    "recordType": { "const": "GovernanceBench" },
    "benchId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "ownerRepo": { "type": "string", "minLength": 1 },
    "scopeRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rubricId", "criteria"],
      "properties": {
        "rubricId": { "type": "string", "minLength": 1 },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterionId", "description", "weight"],
            "properties": {
              "criterionId": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "weight": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "testCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "fixtureRef", "expectedDecision"],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "fixtureRef": { "type": "string", "minLength": 1 },
          "expectedDecision": { "type": "string", "enum": ["allow", "deny", "review_required", "fail_closed"] },
          "failureClass": { "type": "string", "minLength": 1 }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minPassRate", "failClosedRequired"],
      "properties": {
        "minPassRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "failClosedRequired": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdBy", "createdAt", "sourceRepo", "nonSecret"],
      "properties": {
        "createdBy": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "sourceRepo": { "type": "string", "minLength": 1 },
        "sourceCommit": { "type": "string", "minLength": 1 },
        "nonSecret": { "type": "boolean" }
      }
    }
  }
}
