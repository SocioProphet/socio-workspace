{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/sociosphere/governance/replay-bench.v0.1.schema.json",
  "title": "ReplayBench v0.1",
  "description": "Benchmark contract for replayability, graph snapshot availability, and evidence retention.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "benchId", "title", "ownerRepo", "actionRefs", "replayTests", "provenance"],
  "properties": {
    "schemaVersion": { "const": "governance.replay-bench.v0.1" },
    "recordType": { "const": "ReplayBench" },
    "benchId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "ownerRepo": { "type": "string", "minLength": 1 },
    "actionRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "replayTests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["testId", "executionReceiptRef", "graphSnapshotRef", "expectedOutcome"],
        "properties": {
          "testId": { "type": "string", "minLength": 1 },
          "executionReceiptRef": { "type": "string", "minLength": 1 },
          "graphSnapshotRef": { "type": "string", "minLength": 1 },
          "expectedOutcome": { "type": "string", "enum": ["replay_success", "replay_fail", "replay_review_required"] }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdBy", "createdAt", "sourceRepo", "nonSecret"],
      "properties": {
        "createdBy": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "sourceRepo": { "type": "string", "minLength": 1 },
        "sourceCommit": { "type": "string", "minLength": 1 },
        "nonSecret": { "type": "boolean" }
      }
    }
  }
}
