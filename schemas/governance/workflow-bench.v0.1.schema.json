{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/sociosphere/governance/workflow-bench.v0.1.schema.json",
  "title": "WorkflowBench v0.1",
  "description": "Benchmark contract for operational workflow quality, adoption, timing, correction, override, and receipt-backed execution metrics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "benchId", "title", "ownerRepo", "workflowRefs", "metrics", "testCases", "thresholds", "provenance"],
  "properties": {
    "schemaVersion": { "const": "governance.workflow-bench.v0.1" },
    "recordType": { "const": "WorkflowBench" },
    "benchId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "ownerRepo": { "type": "string", "minLength": 1 },
    "workflowRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metricId", "kind", "description"],
        "properties": {
          "metricId": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["quality", "time", "adoption", "correction", "override", "replay", "safety"] },
          "description": { "type": "string", "minLength": 1 },
          "unit": { "type": "string", "minLength": 1 }
        }
      }
    },
    "testCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "procedureTemplateRef", "expectedReceiptRef"],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "procedureTemplateRef": { "type": "string", "minLength": 1 },
          "expectedReceiptRef": { "type": "string", "minLength": 1 },
          "evidenceBundleRef": { "type": "string", "minLength": 1 }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minQualityScore", "maxOverrideRate"],
      "properties": {
        "minQualityScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxOverrideRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "replayRequired": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdBy", "createdAt", "sourceRepo", "nonSecret"],
      "properties": {
        "createdBy": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "sourceRepo": { "type": "string", "minLength": 1 },
        "sourceCommit": { "type": "string", "minLength": 1 },
        "nonSecret": { "type": "boolean" }
      }
    }
  }
}
