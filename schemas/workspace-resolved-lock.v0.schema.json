{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/sociosphere/workspace-resolved-lock.v0.schema.json",
  "title": "WorkspaceResolvedLockV0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source_manifest",
    "source_lock",
    "resolution_mode",
    "repo_count",
    "repos"
  ],
  "properties": {
    "schema_version": { "const": "sociosphere.workspace-resolved-lock.v0" },
    "generated_at": { "type": "string" },
    "source_manifest": { "const": "manifest/workspace.toml" },
    "source_lock": { "const": "manifest/workspace.lock.json" },
    "resolution_mode": { "const": "live_ref_resolution" },
    "repo_count": { "type": "integer", "minimum": 1 },
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/repo" }
    }
  },
  "$defs": {
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "url",
        "declared_ref",
        "declared_rev",
        "resolved_rev",
        "resolution_status"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "local_path": { "type": ["string", "null"] },
        "declared_ref": { "type": ["string", "null"] },
        "declared_rev": { "type": ["string", "null"] },
        "resolved_rev": { "type": ["string", "null"] },
        "resolution_status": {
          "type": "string",
          "enum": ["resolved", "pinned", "unresolved", "drift", "skipped"]
        },
        "resolution_error": { "type": ["string", "null"] },
        "trust_zone": { "type": ["string", "null"] },
        "trust_profile_ref": { "type": ["string", "null"] },
        "license_hint": { "type": ["string", "null"] },
        "required_capabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_grants": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
